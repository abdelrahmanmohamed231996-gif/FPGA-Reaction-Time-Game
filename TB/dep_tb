module dep_tb;

reg rst_n;
reg clk;
reg sw;
wire db;

Debouncer dut (
    .rst_n(rst_n),
    .clk(clk),
    .sw(sw),
    .db(db)
);

always #10 clk = ~clk;

initial begin
    clk   = 1'b0;
    rst_n = 1'b0;
    sw    = 1'b0;

    @(negedge clk);
    @(negedge clk);
    @(negedge clk);

    rst_n = 1'b1;

    @(negedge clk);
    @(negedge clk);
    @(negedge clk);

    sw = 1'b1;

    @(negedge clk);

    sw = 1'b0;

    @(negedge clk);
    @(negedge clk);

    sw = 1'b1;

    @(negedge clk);

    sw = 1'b0;

    @(negedge clk);
    @(negedge clk);

    
    sw = 1'b1;

    repeat (50)@(negedge clk);


    sw = 1'b0;

    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);

    $stop;
end

endmodule
